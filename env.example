# Copy to .env and edit, or set these in your shell / systemd.
# The daily job reads them at runtime.

# REQUIRED for live research (the researchers + judges):
ANTHROPIC_API_KEY=sk-ant-...

# Model + web search (set MODEL to a current one if this ages):
RESLAB_MODEL=claude-opus-4-8
RESLAB_WEB_SEARCH_TOOL=web_search_20250305
RESLAB_MAX_SEARCHES=6

# Universe = Robinhood-buyable small caps (major US exchanges, no OTC):
RESLAB_MIN_MARKET_CAP=300000000      # $300M floor
RESLAB_MAX_MARKET_CAP=5000000000     # $5B ceiling (small / small-mid)
RESLAB_MIN_PRICE=2.0
RESLAB_REQUIRE_VERIFIED=1            # only buy names whose exchange we can verify

# Paper sizing:
RESLAB_CASH_BUDGET=20000
RESLAB_INITIAL_POSITION=1000
RESLAB_ADD_SIZE=600
RESLAB_MAX_POSITION=3000
RESLAB_MAX_OPEN=12
RESLAB_NEW_IDEAS_PER_DAY=2

# Benchmarks ("beating the market"): SPY = S&P 500, IWM = Russell 2000 small caps
RESLAB_BENCHMARKS=SPY,IWM
